{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "node_modules/.cache/pb-site-types",
    "tsBuildInfoFile": "node_modules/.cache/pb-site-types/.tsbuildinfo",
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "vite.config.ts", "vitest.config.ts", "scripts/lib/tokens.mjs"]
}
